# Copy to the git-ignored .env.production.local after checking the target account.
# These are nonsecret resource identifiers. Never put API tokens or model keys here.
SOURCEFLOW_WORKER_NAME=
CLOUDFLARE_ACCOUNT_ID=
SOURCEFLOW_D1_DATABASE_NAME=
SOURCEFLOW_D1_DATABASE_ID=
SOURCEFLOW_R2_BUCKET_NAME=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
# Optional owned hostname. Empty uses the Worker's workers.dev address.
SOURCEFLOW_CUSTOM_DOMAIN=
# Optional Workers AI opt-in. The tracked build config fixes the supported
# @cf/meta/llama-3.3-70b-instruct-fp8-fast model and 4096 output-token ceiling.
SOURCEFLOW_TEXT_PROVIDER=
