# Copy to the git-ignored .env.production.local after checking the target account.
# These are nonsecret resource identifiers. Never put API tokens or model keys here.
SOURCEFLOW_WORKER_NAME=
CLOUDFLARE_ACCOUNT_ID=
SOURCEFLOW_D1_DATABASE_NAME=
SOURCEFLOW_D1_DATABASE_ID=
SOURCEFLOW_R2_BUCKET_NAME=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
# Optional owned hostname. Empty uses the Worker's workers.dev address.
SOURCEFLOW_CUSTOM_DOMAIN=
# Optional Workers AI text translation. The output ceiling is fixed at 4096.
# Qwen is the default; the explicit legacy Llama setting remains readable.
SOURCEFLOW_TEXT_PROVIDER=
SOURCEFLOW_TEXT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Image OCR + Korean text output; source-image cleanup/rendering is separate.
# Enabling this route permits usage billing above Cloudflare's free allocation.
SOURCEFLOW_IMAGE_TEXT_PROVIDER=
SOURCEFLOW_IMAGE_TEXT_MODEL=@cf/qwen/qwen3.8-27b
SOURCEFLOW_IMAGE_TEXT_PAID_ALLOWED=
# Member connection encryption uses a separate 32-byte base64 Worker secret:
# YOOFAM_CREDENTIAL_ENCRYPTION_KEY. Never commit its value.
