# Supplier Hub 전송은 아직 구현/검증되지 않았습니다.
# 기존 SUPPLIER_HUB_ENDPOINT / SUPPLIER_HUB_API_KEY를 지정해도 전송되지 않습니다.
# Cloudflare 계정 ID, API 토큰, 브라우저 인증 정보는 Git에 저장하지 마세요.
# 텍스트 번역: 사용자 지정 Google GTX 주소를 기본으로 사용합니다.
# 로컬 Cloudflare는 Git에서 제외된 .dev.vars에 설정합니다.
SOURCEFLOW_TEXT_PROVIDER=google-free
OPENAI_API_KEY=
SOURCEFLOW_TEXT_MODEL=google-translate-gtx
SOURCEFLOW_TEXT_MAX_OUTPUT_TOKENS=0
# OpenAI를 별도 선택하면 provider=openai와 키/모델/256~8000 토큰을 설정합니다.
SOURCEFLOW_IMAGE_MODEL=
# Cloudflare Access 운영 인증. 실제 배포 전 팀 도메인과 앱 AUD를 설정합니다.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
