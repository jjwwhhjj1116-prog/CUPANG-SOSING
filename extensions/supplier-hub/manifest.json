{
  "manifest_version": 3,
  "name": "YOOFAM 스튜디오 · 판매량 조회·상품 수집",
  "version": "2.1.66",
  "minimum_chrome_version": "120",
  "description": "쿠팡 판매량 조회, 현재 1688 상품 수집, YOOFAM 스튜디오 AI상품등록과 Supplier Hub 견적서 전달을 하나로 연결합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://s.1688.com/*",
    "https://detail.1688.com/*",
    "https://m.1688.com/*",
    "https://h5api.m.1688.com/*",
    "https://itemcdn.tmall.com/1688offer/*",
    "https://supplier.coupang.com/*",
    "https://www.coupang.com/*",
    "https://wing.coupang.com/*"
  ],
  "background": {
    "service_worker": "handoff-worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://s.1688.com/selloffer/offer_search.htm*"],
      "js": ["listing-picker.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://detail.1688.com/offer/*.html*"
      ],
      "js": [
        "page-collector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://sourceflow.jjwwhhjj1116.workers.dev/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "handoff-content.js",
        "single-confirmation.js",
        "single-content.js",
        "native-source-content.js"
      ]
    },
    {
      "matches": [
        "https://www.coupang.com/np/search*",
        "https://www.coupang.com/np/categories/*",
        "https://www.coupang.com/vp/products/*"
      ],
      "js": [
        "sales-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YOOFAM 스튜디오 · 판매량 조회·상품 수집",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
